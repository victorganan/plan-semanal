generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  weeks             Week[]
  projects          Project[]
  habits            Habit[]
  recurringTemplates RecurringTaskTemplate[]
  activityLogs      ActivityLog[]
  integrationTokens IntegrationToken[]
  tasks             Task[]
  pushSubscriptions PushSubscription[]
  areas             Area[]
  tags              Tag[]
  focusSessions     FocusSession[]

  weeklyReminderDayOfWeek Int? // 0=lunes .. 6=domingo
  weeklyReminderTime      String? // "HH:MM"

  dailyCapacityMinutes Int @default(300) // horas reales disponibles al día (por defecto 5h)
  bufferPercent        Int @default(20) // margen para imprevistos, 0-40%; Capacidad = dailyCapacityMinutes × (1 − margen)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Dominio: Plan Semanal ----------

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurrenceFreq {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurrenceEndMode {
  NEVER
  ON_DATE
  AFTER_COUNT
}

enum EisenhowerQuadrant {
  HACER
  DECIDIR
  DELEGAR
  ALGUN_DIA
}

enum TaskKind {
  DAY_AREA
  PRIORITY_ACTION
  CALL
  BACKLOG
}

enum GtdStatus {
  ACTIVA
  ESPERANDO
  ALGUN_DIA
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ActivityAction {
  CREATED
  UPDATED
  COMPLETED
  UNCOMPLETED
  DELETED
}

enum IntegrationProvider {
  TODOIST
}

model Tag {
  id         String @id @default(cuid())
  userId     String
  name       String
  colorIndex Int    @default(0) // índice en la misma paleta de colores que Área (0-7)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model FocusSession {
  id        String   @id @default(cuid())
  userId    String
  taskId    String? // ausente si el pomodoro se hizo sin vincular a una tarea
  minutes   Int // duración real enfocada (normalmente 25, pero puede pararse antes)
  startedAt DateTime

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, startedAt])
  @@index([taskId])
}

model Area {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String?
  order       Int     @default(0)
  colorIndex  Int     @default(0) // índice en la paleta de colores (0-7), elegido por el usuario

  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks    Task[]
  projects Project[]
  recurringTemplates RecurringTaskTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Week {
  id      String @id @default(cuid())
  userId  String
  isoWeek String // formato AAAA-Wnn, p.ej. 2026-W38

  mentalState   Int? // 1-5
  physicalState Int? // 1-5

  objective1 String?
  objective2 String?
  objective3 String?

  mindDump String? @db.Text

  evalNextWeekFocus String? @db.Text
  evalPostponed     String? @db.Text
  evalToImprove     String? @db.Text
  evalDelegate      String? @db.Text

  evalNextWeekFocusProjectIds String[] @default([])
  evalPostponedTaskIds        String[] @default([])
  evalDelegateTaskIds         String[] @default([])

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  days  Day[]
  tasks Task[]
  habitCompletions HabitCompletion[]
  projectFocus     WeekProjectFocus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, isoWeek])
}

model Day {
  id          String  @id @default(cuid())
  weekId      String
  dayOfWeek   Int // 0=lunes ... 6=domingo
  starRating  Int? // 0-5
  journalNote String? @db.Text // una línea de diario del ritual de cierre del día

  week  Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([weekId, dayOfWeek])
}

model Task {
  id     String   @id @default(cuid())
  userId String // dueño directo: necesario porque las tareas BACKLOG no tienen semana
  weekId String? // ausente para kind = BACKLOG sin asignar todavía
  dayId  String? // solo para kind = DAY_AREA
  kind   TaskKind
  areaId String? // solo para kind = DAY_AREA

  text        String
  description String? @db.Text // notas o contexto de la tarea; el título queda para la acción en sí
  done        Boolean  @default(false)
  priority Priority @default(MEDIUM)
  durationMinutes Int? // duración estimada en minutos (pasos de 15')

  quadrant   EisenhowerQuadrant? // clasificación en la matriz de Eisenhower (urgente/importante)
  assignedTo String?             // nombre de la persona asignada; vacío = tú mismo
  isTop3     Boolean             @default(false) // marcada como una de las 3 tareas clave del día (solo DAY_AREA)

  executedMinutes Int @default(0) // tiempo real invertido: manual o acumulado vía sesiones Pomodoro

  isPriority Boolean @default(false) // Acción prioritaria: hace avanzar un Norte o es lo más importante del día/semana
  firstStep  String? // Primer gesto: primer paso físico/digital inmediato (≤120 caracteres)
  context    String? // contexto GTD, con arroba: @ordenador, @casa, @calle…

  gtdStatus    GtdStatus @default(ACTIVA) // activa / esperando / algún día
  processedAt  DateTime? // null = todavía en la Bandeja sin procesar
  waitingOn    String? // persona de la que depende (gtdStatus = ESPERANDO)
  followUpDate DateTime? // fecha de seguimiento (gtdStatus = ESPERANDO)
  snoozeUntil  DateTime? // fecha de reaparición (gtdStatus = ALGUN_DIA)

  rescheduleCount Int @default(0) // nº de veces que se ha pospuesto (no completada, se retrasa la fecha)

  projectId   String?
  scheduledAt DateTime?

  recurrence          Recurrence @default(NONE)
  recurringTemplateId String?

  parentTaskId String? // presente cuando esta tarea es subtarea de un miniproyecto

  order Int @default(0)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  week    Week?    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  day     Day?     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  area    Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recurringTemplate RecurringTaskTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)
  parentTask Task?  @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[] @relation("TaskSubtasks")
  tags       Tag[]
  focusSessions FocusSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([parentTaskId])
  @@index([userId, kind])
  @@index([weekId])
  @@index([dayId])
  @@index([areaId])
  @@index([projectId])
}

model Habit {
  id     String  @id @default(cuid())
  userId String
  name   String
  active Boolean @default(true)
  order  Int     @default(0)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  createdAt DateTime @default(now())

  @@index([userId])
}

model HabitCompletion {
  id        String  @id @default(cuid())
  habitId   String
  weekId    String
  dayOfWeek Int // 0=lunes .. 4=viernes
  done      Boolean @default(false)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  week  Week  @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([habitId, weekId, dayOfWeek])
  @@index([weekId])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  name        String
  areaId      String
  status      ProjectStatus @default(ACTIVE)
  dueDate     DateTime?

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  area          Area                @relation(fields: [areaId], references: [id], onDelete: Restrict)
  tasks         Task[]
  focus         WeekProjectFocus[]
  collaborators ProjectCollaborator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([areaId])
}

model ProjectCollaborator {
  id        String @id @default(cuid())
  projectId String
  name      String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, name])
}

model WeekProjectFocus {
  id        String @id @default(cuid())
  weekId    String
  projectId String

  week    Week    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([weekId, projectId])
}

model RecurringTaskTemplate {
  id     String @id @default(cuid())
  userId String

  areaId    String
  text      String
  priority  Priority   @default(MEDIUM)
  durationMinutes Int?
  active    Boolean    @default(true)

  // Patrón de repetición (equivalente a RRULE): dtstart es la fecha de
  // referencia (primera ocurrencia), de la que se deriva el día de la
  // semana / del mes / del año según freq.
  dtstart             DateTime
  freq                RecurrenceFreq
  interval            Int               @default(1)
  byWeekdays          Int[]             @default([]) // 0=lunes..6=domingo, solo relevante si freq=WEEKLY
  monthlyByNthWeekday Boolean           @default(false) // true: "el enésimo [día de la semana]" en vez del mismo día del mes
  endMode             RecurrenceEndMode @default(NEVER)
  endDate             DateTime?
  endCount            Int?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  area  Area   @relation(fields: [areaId], references: [id], onDelete: Restrict)
  tasks Task[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([areaId])
}

model ActivityLog {
  id         String         @id @default(cuid())
  userId     String
  entityType String // Task | Habit | Week | Project | ...
  entityId   String
  action     ActivityAction
  summary    String
  metadata   Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model IntegrationToken {
  id           String              @id @default(cuid())
  userId       String
  provider     IntegrationProvider
  accessToken  String              @db.Text
  refreshToken String?             @db.Text
  expiresAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}

model PushSubscription {
  id        String @id @default(cuid())
  userId    String
  endpoint  String @db.Text
  p256dh    String @db.Text
  auth      String @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
}
