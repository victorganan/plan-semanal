# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/nortvira"

# Auth.js — genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-en-produccion"

# URL pública de la app en producción (déjalo vacío en local)
# AUTH_URL="https://tu-dominio.com"

# Necesario SIEMPRE, también en Vercel: sin esto el login falla con
# "UntrustedHost" / "problem with the server configuration".
AUTH_TRUST_HOST="true"

# OAuth de Google (Google Cloud Console) — mismo login sirve para Calendar
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Emails con permiso para entrar, separados por comas. Vacío = sin restricción (no recomendado en producción).
ALLOWED_EMAILS="tu-email@gmail.com"

# OAuth de Todoist (Todoist App Console) — opcional
TODOIST_CLIENT_ID=""
TODOIST_CLIENT_SECRET=""

# Notificaciones push del navegador (recordatorio "prepara tu semana").
# Genera un par único por proyecto con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY="" # mismo valor que VAPID_PUBLIC_KEY, expuesto al navegador
VAPID_SUBJECT="mailto:tu-email@dominio.com"

# Protege la ruta de cron que dispara los recordatorios semanales
CRON_SECRET=""
